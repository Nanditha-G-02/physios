# PHYSIOS configuration. Copy to physios.env (same folder) and change what you need.
# Every value can also be set in the environment; the environment wins.

# Where the PHYSIOS gateway listens. Keep 127.0.0.1 unless you trust the network:
# the gateway fronts services that move the robot.
PHYSIOS_HOST=127.0.0.1
PHYSIOS_PORT=8700
# PHYSIOS_ALLOW_REMOTE=1        # required for a non-loopback PHYSIOS_HOST
# PHYSIOS_AUTH_TOKEN=           # operator access token (12+ chars); turns sign-in on.
#                               # Required for a non-loopback PHYSIOS_HOST.
# PHYSIOS_AUTH_SESSION_H=12     # session lifetime in hours

# PHYSIOS services (all part of this repository): the training service
# (backend/physios_trainer), rosbridge and web_video_server of the robot runtime
# (physios-robot container)
PHYSIOS_TRAINER_URL=http://127.0.0.1:8766
PHYSIOS_ROSBRIDGE_URL=ws://127.0.0.1:9090
PHYSIOS_CAMERA_URL=http://127.0.0.1:8080

# The PHYSIOS data folder: datasets (huggingface/lerobot), plans, reviews and runs
# (workspace/physios), checkpoints (outputs/train), extra robot configs (robot-config).
# Shared by the gateway, the training service and the robot runtime. Default: physios/data
# PHYSIOS_DATA_DIR=/home/ihub/physios-data

# LeRobot dataset folders (":"-separated). Default: $PHYSIOS_DATA_DIR/huggingface/lerobot and
# ~/.cache/huggingface/lerobot
# PHYSIOS_DATASET_ROOTS=

# Robot runtime (docker/docker-compose.yml)
# PHYSIOS_ROS_DOMAIN_ID=30
# PHYSIOS_ROBOT_START_ZENOH=1   # 0 if another container already runs the Zenoh router
# PHYSIOS_ROBOT_GPU=auto        # 1 / 0 to force GPU access on or off
# PHYSIOS_ROBOT_BASE_IMAGE=     # ROS 2 Jazzy + PyTorch base image for docker/robot/Dockerfile
# PHYSIOS_FRONTEND_DIST=        # default: physios/frontend/dist
# PHYSIOS_VAR_DIR=              # logs, pid files, activity (default: physios/var)
# PHYSIOS_ROS_TIMEOUT_S=20      # ROS service call timeout
# PHYSIOS_MAX_UPLOAD_MB=128     # robot model uploads
# PHYSIOS_PYTHON=python3        # interpreter used by the start/stop scripts
